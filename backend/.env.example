# 복사해서 backend/.env 로 사용 — 실제 값은 절대 커밋하지 않는다
PORT=3000
NODE_ENV=development

# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=ims
DB_USERNAME=ims_user
DB_PASSWORD=<DB_PASSWORD>

# ── Auth ──
JWT_SECRET=<JWT_SECRET>
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Azure AD (Entra ID) OIDC SSO ──
AZURE_AD_TENANT_ID=<AZURE_AD_TENANT_ID>
AZURE_AD_CLIENT_ID=<AZURE_AD_CLIENT_ID>
AZURE_AD_CLIENT_SECRET=<AZURE_AD_CLIENT_SECRET>

# ── SMTP (선택, 미설정 시 메일 발송 비활성화) ──
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<SMTP_USER>
SMTP_PASS=<SMTP_PASSWORD>
SMTP_FROM=IMS <noreply@example.com>

# ── NetBox 연동 (선택) ──
NETBOX_URL=http://<NETBOX_HOST>:8080/netbox
NETBOX_TOKEN=<NETBOX_API_TOKEN>
NETBOX_SYNC_ITEM_CODES=HW-0001,HW-0004

# ── Notion 카탈로그 연동 (선택) ──
NOTION_TOKEN=<NOTION_TOKEN>
NOTION_DB_BUNDLE=<NOTION_DATABASE_ID>
NOTION_DB_FRONTEND=<NOTION_DATABASE_ID>
NOTION_DB_BACKEND=<NOTION_DATABASE_ID>
NOTION_DB_EMBEDDED=<NOTION_DATABASE_ID>
NOTION_DB_MEDIA=<NOTION_DATABASE_ID>

# ── 자산 사진 저장소 (선택, GCS 버킷) ──
GCS_ASSET_BUCKET=<GCS_BUCKET_NAME>
